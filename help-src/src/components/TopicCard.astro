---
// Home page topic card: illustration, title, and a short
// description. Drop an image named after the topic into public/cards/
// (e.g. public/cards/expenses.png) and it replaces the icon placeholder.
import fs from 'node:fs';
import path from 'node:path';
import { Icon } from '@astrojs/starlight/components';

interface Props {
	title: string;
	description: string;
	href: string;
	/** Docs folder name, also used to find the card image, e.g. "expenses". */
	topic: string;
	/** Starlight icon shown until a card image is added. */
	icon: Parameters<typeof Icon>[0]['name'];
}

const { title, description, href, topic, icon } = Astro.props;

const imageFile = ['png', 'webp', 'jpg', 'svg']
	.map((ext) => `${topic}.${ext}`)
	.find((file) => fs.existsSync(path.join(process.cwd(), 'public', 'cards', file)));
const imageSrc = imageFile && `${import.meta.env.BASE_URL.replace(/\/$/, '')}/cards/${imageFile}`;
---

<a class="hm-topic-card" href={href}>
	{
		imageSrc ? (
			<img class="hm-topic-image" src={imageSrc} alt="" loading="lazy" />
		) : (
			<span class="hm-topic-icon" aria-hidden="true">
				<Icon name={icon} size="2.25rem" />
			</span>
		)
	}
	<span class="hm-topic-title">
		{title}
	</span>
	<span class="hm-topic-description">{description}</span>
</a>

<style>
	.hm-topic-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		padding: 1.5rem 1.25rem 1.375rem;
		background-color: var(--sl-color-black);
		text-align: center;
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}
	.hm-topic-card:hover {
		border-color: var(--sl-color-accent);
		box-shadow: 0 8px 22px rgba(88, 86, 214, 0.12);
		transform: translateY(-2px);
	}
	/* Illustrations (transparent PNGs) sit straight on the card. */
	.hm-topic-image {
		width: 7.5rem;
		height: 7.5rem;
		margin-bottom: 0.75rem;
		object-fit: contain;
	}
	.hm-topic-icon {
		display: grid;
		place-items: center;
		width: 5.5rem;
		height: 5.5rem;
		margin: 0.75rem 0 1.375rem;
		border-radius: 1.375rem;
		background-color: var(--sl-color-accent);
		color: #fff;
	}
	.hm-topic-title {
		color: var(--sl-color-white);
		font-family: var(--hm-font-heading);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: var(--sl-line-height-headings);
	}
	.hm-topic-description {
		max-width: 18rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
</style>
