---
// Home page topic card: illustration, title with article count, and a short
// description. Drop an image named after the topic into public/cards/
// (e.g. public/cards/expenses.png) and it replaces the icon placeholder.
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';

interface Props {
	title: string;
	description: string;
	href: string;
	/** Docs folder whose pages are counted, e.g. "expenses". */
	topic: string;
	/** Starlight icon shown until a card image is added. */
	icon: Parameters<typeof Icon>[0]['name'];
}

const { title, description, href, topic, icon } = Astro.props;
const docs = await getCollection('docs');
const count = docs.filter((entry) => entry.id.startsWith(`${topic}/`) || entry.id === topic).length;

const imageFile = ['png', 'webp', 'jpg', 'svg']
	.map((ext) => `${topic}.${ext}`)
	.find((file) => fs.existsSync(new URL(`../../public/cards/${file}`, import.meta.url)));
const imageSrc = imageFile && `${import.meta.env.BASE_URL.replace(/\/$/, '')}/cards/${imageFile}`;
---

<a class="hm-topic-card" href={href}>
	{
		imageSrc ? (
			<img class="hm-topic-image" src={imageSrc} alt="" loading="lazy" />
		) : (
			<span class="hm-topic-icon" aria-hidden="true">
				<Icon name={icon} size="2.25rem" />
			</span>
		)
	}
	<span class="hm-topic-title">
		{title}
		<span class="hm-topic-count" aria-label={`${count} ${count === 1 ? 'article' : 'articles'}`}>{count}</span>
	</span>
	<span class="hm-topic-description">{description}</span>
</a>

<style>
	.hm-topic-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		padding: 1.5rem 1.25rem 1.375rem;
		background-color: var(--sl-color-black);
		text-align: center;
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}
	.hm-topic-card:hover {
		border-color: var(--sl-color-accent);
		box-shadow: 0 8px 22px rgba(88, 86, 214, 0.12);
		transform: translateY(-2px);
	}
	.hm-topic-image {
		width: 7rem;
		height: 7rem;
		margin-bottom: 0.625rem;
		object-fit: contain;
	}
	.hm-topic-icon {
		display: grid;
		place-items: center;
		width: 5.5rem;
		height: 5.5rem;
		margin: 0.75rem 0 1.375rem;
		border-radius: 1.5rem;
		background: linear-gradient(135deg, #ececfc 0%, #e0f6f3 100%);
		color: var(--sl-color-accent);
	}
	.hm-topic-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
	}
	.hm-topic-count {
		min-width: 1.375rem;
		padding: 0 0.375rem;
		border-radius: 0.375rem;
		background-color: var(--hm-teal-low);
		color: var(--hm-badge);
		font-size: 0.6875rem;
		font-weight: 600;
		text-align: center;
		line-height: 1.6;
	}
	.hm-topic-description {
		max-width: 18rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
</style>
