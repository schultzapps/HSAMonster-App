---
// The support address, obfuscated like the main site's "Contact Us" link. The
// app's Help Center recognizes support@ and shows its own Contact Us choices.
const { label = 'Email support' } = Astro.props;
---

<a href="#" class="hm-contact-link">{label}</a>

<script is:inline>
	document.querySelectorAll('.hm-contact-link').forEach(function (link) {
		link.addEventListener('click', function (e) {
			e.preventDefault();
			window.location.href =
				'mail' + 'to:' + 'support' + '@' + 'hsamonster.com' + '?subject=' + encodeURIComponent('HSA Monster Help');
		});
	});
</script>
